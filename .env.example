# Скопируйте этот файл в .env и при необходимости измените значения.
# Реальные секреты в репозиторий не коммитим!
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Bishkek

# sqlite (по умолчанию, для разработки) или postgres
DB_ENGINE=sqlite
# Для PostgreSQL:
DB_NAME=campusmarket
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
